        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"listId\": {{ $('Loop One by One').first().json.listId }},\n  \"email\": \"{{ $('Loop One by One').first().json.email }}\",\n  \"firstName\": \"{{ $('Loop One by One').first().json.firstName }}\",\n  \"lastName\": \"{{ $('Loop One by One').first().json.lastName }}\",\n  \"companyName\": \"{{ $('Loop One by One').first().json.company }}\",\n  \"companySite\": \"{{ $('Loop One by One').first().json.website_url }}\"\n}",
        "options": {}
