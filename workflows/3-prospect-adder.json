      "id": "fa0d190a-9646-4136-828a-e857aba4efb8",
      "name": "Add Prospect to Snov.io List",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const leadData = $('Loop One by One').first().json;\nconst snovResult = $('Add Prospect to Snov.io List').first().json;\n\n// =====================================================================\n// EDIT THIS: map each ICP name (must match Agent 1's `icps[].name`\n// values exactly) to the name of the cold-email template you've set up\n// in Snov.io for that segment.\n// =====================================================================\nconst icpTemplateMap = {\n  'EXAMPLE-1 -- Replace With Your Own Niche': 'Example 1 Cold Template',\n  'EXAMPLE-2 -- Replace With Your Own Niche': 'Example 2 Cold Template',\n};\n\nconst emailTemplate = icpTemplateMap[leadData.icp] || Object.values(icpTemplateMap)[0];\nconst today = new Date().toISOString().split('T')[0];\n\n// Handle all possible Snov.io responses\nlet snovId = '';\nlet snovStatus = '';\n\nif (snovResult?.success === true && snovResult?.id) {\n  // Successfully added\n  snovId = snovResult.id;\n  snovStatus = 'Added \\u2705';\n} else if (\n  snovResult?.error?.message?.includes('already exists') ||\n  (typeof snovResult?.errors === 'string' && snovResult.errors.includes('already exists'))\n) {\n  // Already in list \\u2014 still treat as success\n  snovStatus = 'Already in list \\u2705';\n} else {\n  // Real error\n  snovStatus = `Error: ${JSON.stringify(snovResult?.errors || snovResult?.message || 'unknown')}`;\n}\n\n// Build profile URL only if we have a real ID\nconst snovProfileUrl = snovId\n  ? `https://app.snov.io/prospects/view/${snovId}/${leadData.listId}`\n  : '';\n\n// Success if added or already exists\nconst success = snovStatus.includes('\\u2705');\n\nreturn [{\n  json: {\n    pageId: leadData.pageId,\n    icp: leadData.icp,\n    email: leadData.email,\n    snov_profile_url: snovProfileUrl,\n    snov_status: snovStatus,\n    emailTemplate,\n    today,\n    success\n  }\n}];\n"
      },
