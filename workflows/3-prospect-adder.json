    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (!items || items.length === 0) {\n  return [{ json: { noLeads: true, total: 0 } }];\n}\n\n// =====================================================================\n// EDIT THIS: map each ICP name (must match Agent 1's `icps[].name`\n// values exactly) to the Snov.io list ID you want that ICP's contacts\n// added to. Create the lists in Snov.io first, then copy their numeric\n// IDs here from the Snov.io dashboard URL.\n// =====================================================================\nconst listIds = {\n  'EXAMPLE-1 -- Replace With Your Own Niche': 0000000,\n  'EXAMPLE-2 -- Replace With Your Own Niche': 0000000,\n};\n\nconst leads = items.map(item => {\n  const props = item.json.properties || {};\n\n  const getTitle = (p) => (!p || !p.title || !p.title.length) ? '' : p.title.map(t => t.plain_text).join('');\n  const getSelect = (p) => (!p || !p.select) ? '' : p.select.name || '';\n  const getEmail = (p) => (!p || !p.email) ? '' : p.email || '';\n  const getRichText = (p) => (!p || !p.rich_text || !p.rich_text.length) ? '' : p.rich_text.map(t => t.plain_text).join('');\n\n  const websiteUrl = getTitle(props['Website URL']);\n  const icp = getSelect(props['ICP']);\n  const email = getEmail(props['Email']);\n  const contactName = getRichText(props['Contact Name']);\n  const company = getRichText(props['Company']) || websiteUrl.replace(/https?:\\/\\/(www\\.)?/, '').split('/')[0];\n\n  // Split contact name into first/last\n  const nameParts = contactName.trim().split(' ');\n  const firstName = nameParts[0] || '';\n  const lastName = nameParts.slice(1).join(' ') || '';\n\n  // Get list ID for ICP\n  const listId = listIds[icp] || null;\n\n  return {\n    pageId: item.json.id,\n    website_url: websiteUrl,\n    icp,\n    email,\n    firstName,\n    lastName,\n    company,\n    listId\n  };\n}).filter(l => l.email && l.listId);\n\nif (!leads.length) {\n  return [{ json: { noLeads: true, total: 0 } }];\n}\n\nreturn [{ json: { noLeads: false, leads, total: leads.length } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        0
      ],
