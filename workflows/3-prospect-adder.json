      "id": "a396eaec-5803-4432-ab95-0e3d2b626c84",
      "name": "Read Qualified Email Found Leads",
      "credentials": {
        "notionApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Notion account-CBL"
        }
      }
