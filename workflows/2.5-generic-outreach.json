    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst lead = $('Loop One by One').first().json;\n\nconst data = (result.data || [])[0] || {};\nconst smtpStatus = data?.result?.smtp_status || 'not_valid';\nconst reason = data?.result?.unknown_status_reason || '';\n\nconst isValid = smtpStatus === 'valid';\n\nreturn [{ json: {\n  pageId: lead.pageId,\n  website_url: lead.website_url,\n  domain: lead.domain,\n  candidate_email: lead.candidate_email,\n  candidate_source: lead.candidate_source,\n  smtp_status: smtpStatus,\n  unknown_status_reason: reason,\n  is_valid: isValid\n} }];"
